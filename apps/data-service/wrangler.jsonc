/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"stage": {
			"vars": {
				"ASSETS_URL": "https://stepps-assets-stage.stepps.ai",
				"CLOUDFLARE_ACCOUNT_ID": "c2ed9b335ebebbe0fbfa7aa17935b3b5",
			},
			"routes": [
				{
					"pattern": "api.stage.stepps.ai",
					"custom_domain": true
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "stepps-assets-stage",
					"remote": true
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "stepps-recording-ingest-queue-stage",
						"dead_letter_queue": "stepps-recording-ingest-dead-letter-stage",
						"max_retries": 3
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "stepps-recording-ingest-queue-stage",
						"remote": true
					}
				]
			},
			"workflows": [
				{
					"name": "guide-pdf-export-workflow-stage",
					"binding": "GUIDE_EXPORT_WORKFLOW",
					"class_name": "GuidePdfExportWorkflow",
					"remote": false
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "GUIDE_SESSION",
						"class_name": "GuideSession"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"GuideSession"
					]
				}
			]
		},
		"production": {
			"vars": {
				"ASSETS_URL": "https://assets.stepps.ai",
				"CLOUDFLARE_ACCOUNT_ID": "c2ed9b335ebebbe0fbfa7aa17935b3b5"
			},
			"routes": [
				{
					"pattern": "api.stepps.ai",
					"custom_domain": true
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "stepps-assets-production",
					"remote": true
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "stepps-recording-ingest-queue-production",
						"dead_letter_queue": "stepps-recording-ingest-dead-letter-production",
						"max_retries": 3
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "stepps-recording-ingest-queue-production",
						"remote": true
					}
				]
			},
			"workflows": [
				{
					"name": "guide-pdf-export-workflow",
					"binding": "GUIDE_EXPORT_WORKFLOW",
					"class_name": "GuidePdfExportWorkflow",
					"remote": false
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "GUIDE_SESSION",
						"class_name": "GuideSession"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"GuideSession"
					]
				}
			]
		}
	}
}
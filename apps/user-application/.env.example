# Example Environment Variables for User Application
# Copy this file to .env or .dev.vars and fill in your actual values

# PostgreSQL Database Connection (Supabase)
DATABASE_URL="postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Application Base URL
VITE_BASE_HOST="localhost:3000"

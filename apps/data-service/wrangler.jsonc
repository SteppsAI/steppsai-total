/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"stage": {
			"vars": {
				"ASSETS_URL": "https://stepps-assets-stage.stepps.ai",
				"CLOUDFLARE_ACCOUNT_ID": "c2ed9b335ebebbe0fbfa7aa17935b3b5"
			},
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "stepps-assets-stage"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "stepps-recording-ingest-queue-stage",
						"dead_letter_queue": "stepps-recording-ingest-dead-letter-stage",
						"max_retries": 3
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "stepps-recording-ingest-queue-stage"
					}
				]
			},
			"workflows": [
				{
					"name": "guide-pdf-export-workflow-stage",
					"binding": "GUIDE_EXPORT_WORKFLOW",
					"class_name": "GuidePdfExportWorkflow"
				}
			],
		},
		"production": {
			"vars": {
				"ASSETS_URL": "https://assets.stepps.ai",
				"CLOUDFLARE_ACCOUNT_ID": "c2ed9b335ebebbe0fbfa7aa17935b3b5"
			},
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "stepps-assets-production"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "stepps-recording-ingest-queue-production",
						"dead_letter_queue": "stepps-recording-ingest-dead-letter-production",
						"max_retries": 3
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "stepps-recording-ingest-queue-production"
					}
				]
			},
			"workflows": [
				{
					"name": "guide-pdf-export-workflow",
					"binding": "GUIDE_EXPORT_WORKFLOW",
					"class_name": "GuidePdfExportWorkflow"
				}
			]
		}
	},
}
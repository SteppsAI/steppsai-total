/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/app/*
  X-Robots-Tag: noindex, nofollow

/auth/*
  X-Robots-Tag: noindex, nofollow

/payment/success
  X-Robots-Tag: noindex, nofollow

/payment/cancel
  X-Robots-Tag: noindex, nofollow

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

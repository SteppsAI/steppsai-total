/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"stage": {
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "stepps-assets-stage"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "stepps-recording-ingest-queue-stage",
						"dead_letter_queue": "stepps-recording-ingest-dead-letter-stage",
						"max_retries": 3
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "stepps-recording-ingest-queue-stage"
					}
				]
			}
		},
		"production": {
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "stepps-assets-production"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "stepps-recording-ingest-queue-production",
						"dead_letter_queue": "stepps-recording-ingest-dead-letter-production",
						"max_retries": 3
					}
				],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "stepps-recording-ingest-queue-production"
					}
				]
			}
		}
	}
}
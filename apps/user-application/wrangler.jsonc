/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/auth/*",
      "/api/webhooks/*",
      "/trpc/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "vars": {
        "ASSETS_URL": "https://stepps-assets-stage.stepps.ai",
        "GOOGLE_CLIENT_ID": "354170279226-thlv63iksq8o6sikimt68jkpcdc9dn4e.apps.googleusercontent.com",
        "VITE_AUTH_URL": "https://stage.stepps.ai"
      },
      "routes": [
        {
          "pattern": "stage.stepps.ai",
          "custom_domain": true
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 200,
            "period": 60
          }
        },
        {
          "name": "TRPC_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-stage",
          "remote": false
        }
      ]
    },
    "production": {
      "vars": {
        "ASSETS_URL": "https://assets.stepps.ai",
        "GOOGLE_CLIENT_ID": "354170279226-thlv63iksq8o6sikimt68jkpcdc9dn4e.apps.googleusercontent.com",
        "VITE_AUTH_URL": "https://stepps.ai"
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "TRPC_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-production",
          "remote": true
        }
      ]
    }
  }
}